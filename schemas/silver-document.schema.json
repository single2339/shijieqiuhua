{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osint-network.local/schemas/silver-document.schema.json",
  "title": "标准证据文档",
  "type": "object",
  "required": [
    "silver_document_id",
    "canonical_text",
    "raw_document_ids"
  ],
  "properties": {
    "silver_document_id": { "type": "string", "format": "uuid" },
    "canonical_text": { "type": "string" },
    "language": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" },
    "title": { "type": "string" },
    "raw_document_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "minItems": 1
    },
    "dedupe_fingerprint": { "type": "string" },
    "pii_flags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
