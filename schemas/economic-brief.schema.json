{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osint-network.local/schemas/economic-brief.schema.json",
  "title": "EconomicBrief",
  "type": "object",
  "required": ["brief_id", "tenant_id", "focus", "scenarios", "limitations"],
  "properties": {
    "brief_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string" },
    "focus": { "const": "economics" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary", "cited_claim_ids", "confidence"],
        "properties": {
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "cited_claim_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "indicators_touched": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": false
}
