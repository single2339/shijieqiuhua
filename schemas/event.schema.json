{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osint-network.local/schemas/event.schema.json",
  "title": "情报事件",
  "type": "object",
  "required": ["event_id", "event_type", "event_time", "source_silver_document_ids"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string" },
    "event_time": { "type": "string", "format": "date-time" },
    "location_entity_id": { "type": "string", "format": "uuid" },
    "participant_entity_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "source_silver_document_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "minItems": 1
    },
    "event_key": { "type": "string" },
    "layer": { "type": "string" },
    "title": { "type": "string" },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "confidence_level": { "type": "string", "enum": ["L1", "L2", "L3", "L4"] },
    "independent_source_count": { "type": "integer", "minimum": 0 },
    "evidence_count": { "type": "integer", "minimum": 0 },
    "impact": { "type": "string", "enum": ["low", "medium", "high"] },
    "urgency": { "type": "string", "enum": ["low", "medium", "high"] }
  },
  "additionalProperties": true
}
