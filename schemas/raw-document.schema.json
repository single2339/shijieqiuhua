{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osint-network.local/schemas/raw-document.schema.json",
  "title": "RawDocument",
  "type": "object",
  "required": [
    "raw_document_id",
    "job_id",
    "channel",
    "mime_type",
    "captured_at",
    "collector_id",
    "collector_version",
    "source_system",
    "content_sha256"
  ],
  "properties": {
    "raw_document_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "channel": {
      "type": "string",
      "enum": ["web", "social", "api", "app"]
    },
    "mime_type": { "type": "string", "minLength": 1 },
    "encoding": { "type": "string", "default": "utf-8" },
    "body_ref": {
      "type": "string",
      "description": "Object storage URI or logical pointer to Bronze blob"
    },
    "body_inline": {
      "type": "string",
      "description": "Small payloads only; size limits enforced by service"
    },
    "headers_summary": { "type": "object", "additionalProperties": true },
    "captured_at": { "type": "string", "format": "date-time" },
    "collector_id": { "type": "string", "minLength": 1 },
    "collector_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z-.]+)?$"
    },
    "source_url": { "type": "string", "format": "uri" },
    "source_system": { "type": "string", "minLength": 1 },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "classification": {
      "type": "string",
      "enum": ["PUBLIC_AGG", "PUBLIC_DOC", "SENSITIVE_METADATA", "PII", "RESTRICTED"]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "ext_schema_version": { "type": "string" }
  },
  "oneOf": [
    { "required": ["body_ref"] },
    { "required": ["body_inline"] }
  ],
  "additionalProperties": false
}
